APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Microservice split (Task 2) ─────────────────────────────
IDENTITY_DB_PASSWORD=
SCHOOL_DB_PASSWORD=
FINANCE_DB_PASSWORD=
DB_FINANCE_HOST=mysql-finance
DB_FINANCE_PORT=3306
DB_FINANCE_DATABASE=finance_db
DB_FINANCE_USERNAME=finance_user
DB_FINANCE_URL=
# JWT secret cho identity (RS256 legacy fallback) — Go resource server KHÔNG dùng (T3.1 dùng JWKS)
IDENTITY_JWT_SECRET=

# ── Go Resource Servers — JWKS (T3.1) ─────────────────────────
# Finance/Notify verify RS256 qua JWKS cache (MicahParks/keyfunc), kiểm tra iss/aud/exp/kid/tv/sid
AUTH_ISSUER=http://localhost
AUTH_AUDIENCE=educonnect-api
AUTH_JWKS_URL=http://gateway/.well-known/jwks.json
# AUTH_STRICT_CLAIMS=false để tương thích token legacy (iss=request URL,
# không aud/sid/kid; roles lấy từ users_read_model). Bật true khi auth flow
# mới phát hành token đầy đủ iss/aud/sid/kid. Chữ ký + exp + tv/ver luôn check.
AUTH_STRICT_CLAIMS=false

# ── RabbitMQ (Task 2.2) ─────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=educonnect
RABBITMQ_PASSWORD=
RABBITMQ_ERLANG_COOKIE=change-me-cluster-cookie
RABBITMQ_CLUSTER_SIZE=3

# ── Nginx gateway (Task 2.1) ────────────────────────────────
NGINX_HOST=localhost
GATEWAY_DOMAIN=localhost
GATEWAY_PORT=8080

# ── JWT RS256 / JWKS (T1.1+T1.2) ──────────────────────────────────────
JWT_ALGO=RS256
JWT_PRIVATE_KEY=file://storage/certs/jwt-private.pem
JWT_PUBLIC_KEY=file://storage/certs/jwt-public.pem
JWT_PASSPHRASE=
JWT_TTL=10
JWT_REFRESH_TTL=10080
JWT_JWKS_TTL=3600
JWT_ISS=${APP_URL}
JWT_AUD=educonnect-api
JWT_KID=educonnect-rs256-1
JWT_LEEWAY=0
JWT_BLACKLIST_ENABLED=true
JWT_EDDSA_KID=educonnect-eddsa-1
# T1.3 refresh rotation grace 10-30s + reuse detection (family/session)
JWT_REFRESH_GRACE=30
